# ==============================================================================
# SST PRO - Modelo de Configuração (.env.example)
# ==============================================================================
PORT=3000

# Sincronização e Backup com GitHub
GITHUB_TOKEN=
GITHUB_REPO=Miranhada07/sst-pro

# ==============================================================================
# 📧 SERVIÇO DE E-MAIL SMTP (Autenticação 2FA e Acesso do Site)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-ou-senha-smtp
SMTP_FROM_NAME="SST PRO - Segurança do Trabalho"
SMTP_FROM_EMAIL=notificacoes@seudominio.com.br
